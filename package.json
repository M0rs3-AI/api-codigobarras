{
  "name": "bridge-codigobarras",
  "version": "2.0.0",
  "description": "Bridge local que consulta codigos de barras contra SQL Server, empaquetado como binario por cliente",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "package": "node build.mjs",
    "token": "node build.mjs --token"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "kysely": "^0.29.5",
    "tarn": "^3.1.2",
    "tedious": "^16.7.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.5",
    "@types/tedious": "^4.0.14",
    "esbuild": "^0.25.0",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
