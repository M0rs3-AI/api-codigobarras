# Plantilla de configuracion. SOLO para desarrollo local.
#
# En produccion NO se usa este archivo: la configuracion viaja dentro del
# binario del cliente (ver README, "Empaquetar para un cliente"). Copia este
# archivo a ".env" solo para trabajar en local.

# --- Obligatorias -----------------------------------------------------------

# Secreto que exige el bridge en el header "x-bridge-token".
# Generalo con: npm run token
BRIDGE_TOKEN=

# Conexion a SQL Server. Usa el usuario de minimo privilegio que crea
# sql/01-usuario-minimo-privilegio.sql, NUNCA 'sa'.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=nombre_db
SQL_USER=bridge_codigobarras
SQL_PASSWORD=

# Stored procedure principal y el nombre de su parametro de entrada (sin la @).
SP_NAME=INV_Pproductos_Seek_Codigo_Barra
SP_PARAM_NAME=CodigoBarra

# --- Opcionales -------------------------------------------------------------

# Puerto e interfaz. Con tunel de Cloudflare usa BIND_HOST=127.0.0.1: el bridge
# deja de ser alcanzable desde la red y no queda ningun puerto expuesto.
PORT=3001
BIND_HOST=0.0.0.0

# SP de stock por bodega. Devuelve filas { Nombre, Stock } y opcionalmente
# Ubicacion. Vacio = este cliente no maneja stock por bodega.
SP_STOCK_NAME=
SP_STOCK_PARAM_NAME=CodigoBarra

# SP de busqueda por texto (ver sql/02-sp-busqueda.sql).
# Vacio = /search responde 501 y la app oculta la busqueda por nombre.
SP_SEARCH_NAME=
SP_SEARCH_PARAM_NAME=q
SP_SEARCH_LIMIT_PARAM_NAME=top

# TLS hacia SQL Server. Desactivar solo en instancias antiguas que no lo soporten.
SQL_ENCRYPT=true
SQL_TRUST_CERT=true

# Pool de conexiones.
SQL_POOL_MAX=4

# Limites. RATE_LIMIT_PER_MINUTE es POR TOKEN, no global.
RATE_LIMIT_PER_MINUTE=120
MAX_SEARCH_RESULTS=25
MAX_BARCODE_LENGTH=64
MAX_QUERY_LENGTH=100

# HTTPS directo. Alternativa al tunel para clientes con dominio propio.
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
