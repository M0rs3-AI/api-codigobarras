# Plantilla de configuracion. SOLO para desarrollo local.
#
# En produccion NO se usa este archivo: la configuracion viaja dentro del
# binario del cliente (ver README, "Empaquetar para un cliente"). Copia este
# archivo a ".env" solo para trabajar en local.

# --- Obligatorias -----------------------------------------------------------

# Secreto que exige el bridge en el header "x-bridge-token".
# Generalo con: npm run token
BRIDGE_TOKEN=

# Conexion a SQL Server. Usa el usuario de minimo privilegio que crea
# sql/01-usuario-minimo-privilegio.sql, NUNCA 'sa'.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=nombre_db
SQL_USER=bridge_codigobarras
SQL_PASSWORD=

# Stored procedure principal y el nombre de su parametro de entrada (sin la @).
SP_NAME=INV_Pproductos_Seek_Codigo_Barra
SP_PARAM_NAME=CodigoBarra

# --- Opcionales -------------------------------------------------------------

# Puerto e interfaz. Con tunel de Cloudflare usa BIND_HOST=127.0.0.1: el bridge
# deja de ser alcanzable desde la red y no queda ningun puerto expuesto.
PORT=3001
BIND_HOST=0.0.0.0

# Deja GET /health sin token. Por defecto false: sin token TODAS las rutas
# responden 401 o 404, asi que escanear el puerto no revela nada. Ponlo en true
# solo si un monitor externo no puede enviar cabeceras.
HEALTH_PUBLIC=false

# SP de stock por bodega. Devuelve filas { Nombre, Stock } y opcionalmente
# Ubicacion. Vacio = este cliente no maneja stock por bodega.
SP_STOCK_NAME=
SP_STOCK_PARAM_NAME=CodigoBarra

# SP de busqueda por texto (ver sql/02-sp-busqueda.sql).
# Vacio = /search responde 501 y la app oculta la busqueda por nombre.
SP_SEARCH_NAME=
SP_SEARCH_PARAM_NAME=q
SP_SEARCH_LIMIT_PARAM_NAME=top

# --- Login de usuario (opcional) --------------------------------------------

# Exige login de usuario en /query y /search, validado contra SEG_USUARIOS del
# ERP. Actívalo SOLO para clientes cuya app tenga pantalla de login: una app sin
# ella no envia sesion y recibiria 401 en cada escaneo.
AUTH_ENABLED=false

# SP que devuelve la contrasena cifrada. El del ERP ya filtra por Anulado = 0.
# Ver sql/03-auth-usuarios.sql; solo hace falta el GRANT EXECUTE.
AUTH_SP_LOGIN_NAME=dbo.SEG_Usuarios_Select_Password

# SP opcional que solo responde si el usuario sigue de alta. Se llama en cada
# escaneo, asi que evita arrastrar la contrasena cifrada cientos de veces al
# dia. Vacio = se reutiliza el SP de login, que tambien filtra por Anulado.
AUTH_SP_STATUS_NAME=

# Pagina de codigos con la que el driver decodifica la columna Password:
# 'cp1252' (intercalaciones latinas, lo habitual) o 'latin1'. Irrelevante si se
# usa el SP envoltorio que devuelve varbinary (ver sql/03-auth-usuarios.sql).
AUTH_PASSWORD_ENCODING=cp1252

# Clave con la que se firman los tokens de sesion. Si se deja vacia se deriva
# del BRIDGE_TOKEN por HKDF, pero es mejor tener una propia: asi, si el
# BRIDGE_TOKEN se filtra en un log o un proxy, nadie puede fabricar sesiones.
# Generala con: npm run token
AUTH_SECRET=

# Duracion de la sesion en minutos (720 = 12 h).
AUTH_SESSION_TTL_MINUTES=720

# Segundos que se reutiliza un "usuario activo" ya comprobado. El estado se
# consulta en cada escaneo; esta ventana solo evita que una rafaga de escaneos
# golpee la base una vez por codigo. 0 = consultar siempre. Los resultados
# negativos NUNCA se cachean: dar de baja a alguien surte efecto de inmediato.
AUTH_STATUS_CACHE_SECONDS=15

# Intentos de login por minuto y por (usuario, IP). Los aciertos no cuentan.
AUTH_LOGIN_RATE_PER_MINUTE=10

# Topes de entrada del login. 15 = ancho de SEG_USUARIOS.Codigo.
AUTH_MAX_USERNAME_LENGTH=15
AUTH_MAX_PASSWORD_LENGTH=128

# TLS hacia SQL Server. Desactivar solo en instancias antiguas que no lo soporten.
SQL_ENCRYPT=true
SQL_TRUST_CERT=true

# Pool de conexiones.
SQL_POOL_MAX=4

# Limites. RATE_LIMIT_PER_MINUTE es POR TOKEN, no global.
RATE_LIMIT_PER_MINUTE=120
MAX_SEARCH_RESULTS=25
MAX_BARCODE_LENGTH=64
MAX_QUERY_LENGTH=100

# HTTPS directo. Alternativa al tunel para clientes con dominio propio.
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=
