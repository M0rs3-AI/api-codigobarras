# Solo desarrollo local. En produccion la configuracion viaja dentro del binario
# (ver README, "Desplegar en un cliente").

# --- Obligatorias -----------------------------------------------------------

# Secreto del header x-bridge-token. Generar con: npm run token
BRIDGE_TOKEN=

# Usuario de minimo privilegio de sql/01, nunca 'sa'.
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=nombre_db
SQL_USER=bridge_codigobarras
SQL_PASSWORD=

# SP principal y su parametro de entrada, sin la @.
SP_NAME=INV_Pproductos_Seek_Codigo_Barra
SP_PARAM_NAME=CodigoBarra

# --- Red --------------------------------------------------------------------

# 127.0.0.1 con tunel: el bridge deja de ser alcanzable desde la red.
PORT=3001
BIND_HOST=0.0.0.0

# true deja GET /health sin token. Solo si un monitor no puede enviar cabeceras.
HEALTH_PUBLIC=false

# HTTPS directo. Alternativa al tunel para clientes con dominio propio.
TLS_ENABLED=false
TLS_CERT_PATH=
TLS_KEY_PATH=
TLS_CA_PATH=

# --- SPs opcionales ---------------------------------------------------------

# Stock por bodega. Vacio = este cliente no lo usa.
SP_STOCK_NAME=
SP_STOCK_PARAM_NAME=CodigoBarra

# Busqueda por texto (sql/02). Vacio = /search responde 501.
SP_SEARCH_NAME=
SP_SEARCH_PARAM_NAME=q
SP_SEARCH_LIMIT_PARAM_NAME=top

# --- Login de usuario -------------------------------------------------------

# Solo para clientes cuya app tenga pantalla de login: una app sin ella no envia
# sesion y recibiria 401 en cada escaneo.
AUTH_ENABLED=false

# SP de la contrasena cifrada. El del ERP ya filtra por Anulado = 0.
AUTH_SP_LOGIN_NAME=dbo.SEG_Usuarios_Select_Password

# SP ligero de "sigue de alta". Vacio = se reutiliza el de login.
AUTH_SP_STATUS_NAME=

# Pagina de codigos de la columna Password: cp1252 o latin1. Irrelevante con el
# SP envoltorio varbinary de sql/03.
AUTH_PASSWORD_ENCODING=cp1252

# Firma de las sesiones. Vacio = se deriva del BRIDGE_TOKEN por HKDF; es mejor
# tener una propia. Generar con: npm run token
AUTH_SECRET=

# 720 = 12 h.
AUTH_SESSION_TTL_MINUTES=720

# Segundos que se reutiliza un "activo" ya comprobado; 0 = consultar siempre.
# Los negativos nunca se cachean: la baja surte efecto de inmediato.
AUTH_STATUS_CACHE_SECONDS=15

# Intentos de login por minuto y por (usuario, IP). Los aciertos no cuentan.
AUTH_LOGIN_RATE_PER_MINUTE=10

# 15 = ancho de SEG_USUARIOS.Codigo.
AUTH_MAX_USERNAME_LENGTH=15
AUTH_MAX_PASSWORD_LENGTH=128

# --- Limites y conexion -----------------------------------------------------

# TLS hacia SQL Server. false solo en instancias antiguas que no lo soporten.
SQL_ENCRYPT=true
SQL_TRUST_CERT=true
SQL_POOL_MAX=4

# RATE_LIMIT_PER_MINUTE es por token, no global.
RATE_LIMIT_PER_MINUTE=120
MAX_SEARCH_RESULTS=25
MAX_BARCODE_LENGTH=64
MAX_QUERY_LENGTH=100
